# 이 파일을 복사해서 이름을 local-db.properties 로 바꾸고, 아래 값을 본인 것으로 채우세요.
#   (local-db.properties 는 .gitignore 에 등록되어 Git 에 올라가지 않습니다.)
# 프로젝트 루트(build.gradle 이 있는 폴더)에 두면 서버를 켤 때 자동으로 읽습니다.

# --- MySQL 계정 ---
spring.datasource.username=root
spring.datasource.password=여기에_MySQL_비밀번호

# --- 관리자 계정 (서버를 켤 때 없으면 만들어집니다) ---
app.admin.username=admin
app.admin.password=여기에_관리자_비밀번호
